{
  "name": "animedoro-pro",
  "version": "0.1.0",
  "description": "Animedoro desktop timer with diary and stats",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.animedoro.pro",
    "productName": "Animedoro Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
